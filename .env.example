# --- Lead notifications (POST /api/supplier-signup, POST /api/buyer-lead-submit) — server-only; never VITE_* ---
# Resend — https://resend.com/api-keys — used to email a lead notification on every submission.
RESEND_API_KEY=
# Comma-separated inboxes (e.g. haroldtrakhman@gmail.com)
CHECKOUT_NOTIFY_TO=
# Optional. For production, use a verified domain in Resend, e.g. "Traffic Control Supply <leads@yourdomain.com>"
# CHECKOUT_EMAIL_FROM=Traffic Control Supply <onboarding@resend.dev>

# --- Supabase (supplier_signups, buyer_leads) — server-only; never VITE_* ---
# https://supabase.com/dashboard/project/_/settings/api
# Vercel: you can use either SUPABASE_URL or NEXT_PUBLIC_SUPABASE_URL (same value); service role is server-only.
SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_URL=   # optional alias (read by API if SUPABASE_URL unset)
SUPABASE_SERVICE_ROLE_KEY=

# PostHog (product analytics) — https://posthog.com — Project settings → Project API key.
# Without VITE_PUBLIC_POSTHOG_TOKEN the app runs normally but sends no PostHog events.
# VITE_PUBLIC_POSTHOG_TOKEN=phc_xxxxxxxx
# US (default in code if host omitted): https://us.i.posthog.com
# EU: https://eu.i.posthog.com
# VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
